# ============================================
# Node / TypeScript Backend - .gitignore
# ============================================

# Node modules
node_modules/

# Environment variables
.env
.env.*.local
*.env

# Build output
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime files
pids/
*.pid
*.seed
*.pid.lock

# Debugger output
.vs/
.idea/
.vscode/

# Cache
.cache/
.temp/
tmp/

# TypeScript
*.tsbuildinfo

# Coverage
coverage/
.nyc_output/

# OS files
.DS_Store
Thumbs.db

# Optional: ignore local files
*.local


